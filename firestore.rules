rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero-Insecure Defaults: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // DIRECTIVE 9: Server-Side Role Helper
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // DIRECTIVE 9: User Profiles with Anti-Self-Elevation
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      // Users can create their initial profile, but CANNOT self-elevate on creation (must be 'user' or unset)
      allow create: if request.auth != null && request.auth.uid == userId
        && (!("role" in request.resource.data) || request.resource.data.role == 'user');
      // Users can update their own doc, but NEVER their own role field
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      // Only an existing admin can change a role or delete user accounts
      allow write: if isAdmin();
    }

    // DIRECTIVE 9: Immutable Admin Audit Log (written only by backend Admin SDK)
    match /adminAuditLog/{logId} {
      allow read: if isAdmin();
      allow write: if false; // written only by Admin SDK on the backend, which bypasses rules
    }

    // DIRECTIVE 11: Expiring Shareable Read Links
    // Backend-only access via Admin SDK, never exposed to any client
    match /shareLinks/{token} {
      allow read, write: if false;
    }


    // User Data Isolation, Admin Moderation & Mood Score Validation (Directives 8, 9, 11 & 12)
    match /users/{userId}/entries/{entryId} {
      allow create: if request.auth != null && request.auth.uid == userId
        && (!("location" in request.resource.data) ||
            request.resource.data.location == null ||
            (request.resource.data.location.lat is number &&
             request.resource.data.location.lat >= -90 &&
             request.resource.data.location.lat <= 90 &&
             request.resource.data.location.lng is number &&
             request.resource.data.location.lng >= -180 &&
             request.resource.data.location.lng <= 180))
        && (!("moodScore" in request.resource.data) ||
            request.resource.data.moodScore == null ||
            (request.resource.data.moodScore is number &&
             request.resource.data.moodScore >= -1 &&
             request.resource.data.moodScore <= 1))
        && (!("moodLabel" in request.resource.data) ||
            request.resource.data.moodLabel == null ||
            (request.resource.data.moodLabel is string &&
             request.resource.data.moodLabel.size() <= 32))
        && (!("sentimentExplanation" in request.resource.data) ||
            request.resource.data.sentimentExplanation == null ||
            (request.resource.data.sentimentExplanation is string &&
             request.resource.data.sentimentExplanation.size() <= 500));
      allow update: if (request.auth != null && request.auth.uid == userId
        && (!("location" in request.resource.data) ||
            request.resource.data.location == null ||
            (request.resource.data.location.lat is number &&
             request.resource.data.location.lat >= -90 &&
             request.resource.data.location.lat <= 90 &&
             request.resource.data.location.lng is number &&
             request.resource.data.location.lng >= -180 &&
             request.resource.data.location.lng <= 180))
        && (!("moodScore" in request.resource.data) ||
            request.resource.data.moodScore == null ||
            (request.resource.data.moodScore is number &&
             request.resource.data.moodScore >= -1 &&
             request.resource.data.moodScore <= 1))
        && (!("moodLabel" in request.resource.data) ||
            request.resource.data.moodLabel == null ||
            (request.resource.data.moodLabel is string &&
             request.resource.data.moodLabel.size() <= 32))
        && (!("sentimentExplanation" in request.resource.data) ||
            request.resource.data.sentimentExplanation == null ||
            (request.resource.data.sentimentExplanation is string &&
             request.resource.data.sentimentExplanation.size() <= 500)))
        || isAdmin();
      allow read, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/interactions/{interactionId} {
      allow create: if request.auth != null && request.auth.uid == userId
        && (!("location" in request.resource.data) ||
            request.resource.data.location == null ||
            (request.resource.data.location.lat is number &&
             request.resource.data.location.lat >= -90 &&
             request.resource.data.location.lat <= 90 &&
             request.resource.data.location.lng is number &&
             request.resource.data.location.lng >= -180 &&
             request.resource.data.location.lng <= 180))
        && (!("moodScore" in request.resource.data) ||
            request.resource.data.moodScore == null ||
            (request.resource.data.moodScore is number &&
             request.resource.data.moodScore >= -1 &&
             request.resource.data.moodScore <= 1))
        && (!("moodLabel" in request.resource.data) ||
            request.resource.data.moodLabel == null ||
            (request.resource.data.moodLabel is string &&
             request.resource.data.moodLabel.size() <= 32))
        && (!("sentimentExplanation" in request.resource.data) ||
            request.resource.data.sentimentExplanation == null ||
            (request.resource.data.sentimentExplanation is string &&
             request.resource.data.sentimentExplanation.size() <= 500));
      allow update: if (request.auth != null && request.auth.uid == userId
        && (!("location" in request.resource.data) ||
            request.resource.data.location == null ||
            (request.resource.data.location.lat is number &&
             request.resource.data.location.lat >= -90 &&
             request.resource.data.location.lat <= 90 &&
             request.resource.data.location.lng is number &&
             request.resource.data.location.lng >= -180 &&
             request.resource.data.location.lng <= 180))
        && (!("moodScore" in request.resource.data) ||
            request.resource.data.moodScore == null ||
            (request.resource.data.moodScore is number &&
             request.resource.data.moodScore >= -1 &&
             request.resource.data.moodScore <= 1))
        && (!("moodLabel" in request.resource.data) ||
            request.resource.data.moodLabel == null ||
            (request.resource.data.moodLabel is string &&
             request.resource.data.moodLabel.size() <= 32))
        && (!("sentimentExplanation" in request.resource.data) ||
            request.resource.data.sentimentExplanation == null ||
            (request.resource.data.sentimentExplanation is string &&
             request.resource.data.sentimentExplanation.size() <= 500)))
        || isAdmin();
      allow read, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}
